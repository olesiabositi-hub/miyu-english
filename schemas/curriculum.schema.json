{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MIYU English curriculum",
  "type": "object",
  "required": ["course", "totalLessons", "modules"],
  "properties": {
    "course": { "type": "string" },
    "totalLessons": { "const": 90 },
    "modules": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "lessons"],
        "properties": {
          "id": { "type": "string", "pattern": "^M\\d{2}$" },
          "number": { "type": "integer" },
          "title": { "type": "string" },
          "days": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "lessons": { "type": "array", "items": { "type": "object", "required": ["id", "number", "title"], "properties": { "id": { "type": "string", "pattern": "^D\\d{3}$" }, "number": { "type": "integer" }, "title": { "type": "string" } } } }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miyu.academy/schemas/lesson.schema.json",
  "title": "MIYU English Lesson Contract v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "moduleId", "sequence", "title", "level", "status", "outcomes", "language", "durationMinutes", "lexicalChunks", "grammar", "sections", "tasks", "review", "quality"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^D[0-9]{3}$"},
    "moduleId": {"type": "string", "pattern": "^M[0-9]{2}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 90},
    "title": {"type": "string", "minLength": 1},
    "level": {"type": "string", "enum": ["B2", "B2+", "C1"]},
    "status": {"type": "string", "enum": ["draft", "review", "approved", "published"]},
    "language": {"const": "en"},
    "durationMinutes": {"type": "integer", "minimum": 15},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cefrScale": {"type": "string"},
    "lexicalChunks": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grammar": {"type": "array", "items": {"type": "string"}},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "tasks": {"type": "array", "minItems": 14, "items": {"$ref": "#/$defs/task"}},
    "review": {"$ref": "#/$defs/review"},
    "quality": {"$ref": "#/$defs/quality"}
  },
  "$defs": {
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["intro", "reading", "listening", "grammar", "vocabulary", "pronunciation", "speaking", "writing", "mediation", "reflection", "review", "other"]},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "assetRefs": {"type": "array", "items": {"type": "string"}},
        "transcript": {"type": "string"},
        "evidenceSpans": {"type": "array", "items": {"$ref": "#/$defs/evidenceSpan"}}
      }
    },
    "evidenceSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "startSeconds": {"type": "number", "minimum": 0},
        "endSeconds": {"type": "number", "minimum": 0}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "prompt", "responseType", "scoring", "dependencies"],
      "properties": {
        "id": {"type": "string", "pattern": "^D[0-9]{3}-T[0-9]{2}$"},
        "type": {"type": "string", "minLength": 1},
        "sectionId": {"type": "string"},
        "prompt": {"type": "string"},
        "responseType": {"enum": ["single_choice", "multiple_choice", "short_text", "long_text", "audio_recording", "ordering", "matching", "gap_fill", "self_reflection"]},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "scoring": {"$ref": "#/$defs/scoring"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "feedback": {"type": "string"},
        "tutorRules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {"id": {"type": "string"}, "text": {"type": "string"}}
    },
    "scoring": {
      "type": "object", "additionalProperties": false, "required": ["mode", "maxPoints"],
      "properties": {
        "mode": {"enum": ["auto", "rubric", "manual", "formative"]},
        "maxPoints": {"type": "number", "minimum": 0},
        "correctOptionIds": {"type": "array", "items": {"type": "string"}},
        "acceptedAnswers": {"type": "array", "items": {"type": "string"}},
        "rubric": {"type": "string"},
        "evidenceSpanIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["retrievalPrompts", "delayedTransfer"],
      "properties": {
        "retrievalPrompts": {"type": "array", "items": {"type": "string"}},
        "delayedTransfer": {"type": "string"}
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false, "required": ["editorialApproved", "answerKeyVerified", "audioReviewed", "notes"],
      "properties": {
        "editorialApproved": {"type": "boolean"},
        "answerKeyVerified": {"type": "boolean"},
        "audioReviewed": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
